{
  "name": "hisar-desktop-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview:ui": "VITE_PREVIEW=true vite --port 5180 --strictPort",
    "build:dev": "vue-tsc && vite build --minify false --mode development",
    "build": "vue-tsc && vite build --mode production",
    "typecheck": "vue-tsc",
    "test": "vitest run",
    "test:end-to-end": "playwright test",
    "check:bundle": "vite build --mode production && ! grep -rlE 'previewApi|applyPreviewParameter|Staging database' dist"
  },
  "dependencies": {
    "@wailsio/runtime": "3.0.0-beta.23",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "dom-accessibility-api": "0.7.1",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.11"
  }
}
