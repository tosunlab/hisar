# The domain nginx serves Hisar at; clients and invite links use https://<domain>.
HISAR_DOMAIN=hisar.example.com
# The server image the release pipeline pushes, without a tag.
HISAR_IMAGE=reg.tryhisar.com/hisar/core/hisar-server
# Pin a release (e.g. 0.1.0) so upgrades are deliberate.
HISAR_VERSION=latest
# The localhost port nginx proxies to.
HISAR_PORT=8080
