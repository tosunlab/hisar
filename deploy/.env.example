# The domain nginx serves Hisar at; clients and invite links use https://<domain>.
HISAR_DOMAIN=hisar.example.com
# The server image the release pipeline pushes, without a tag.
HISAR_IMAGE=reg.tryhisar.com/hisar/core/hisar-server
# Pin a release (e.g. 0.1.0) so upgrades are deliberate.
HISAR_VERSION=latest
# The localhost port nginx proxies to.
HISAR_PORT=8080

# Optional: serve macOS app updates from the GitLab project that publishes the hisar-desktop package.
# The token is a project access token with the Reporter role and the read_api scope (see README.md).
#HISAR_UPDATE_GITLAB_URL=https://git.tryhisar.com
#HISAR_UPDATE_GITLAB_PROJECT_ID=2
#HISAR_UPDATE_GITLAB_TOKEN=

# Optional: email for invites and share invitations. All five or none; the server refuses to start with only some.
# Port 465 uses implicit TLS; any other port must offer STARTTLS (see README.md).
#HISAR_SMTP_HOST=smtp.example.com
#HISAR_SMTP_PORT=587
#HISAR_SMTP_USERNAME=
#HISAR_SMTP_PASSWORD=
#HISAR_SMTP_FROM=Hisar <noreply@example.com>

# Optional: sell Pro through Lemon Squeezy. The first five together or none; without them nothing is sold (see README.md).
#HISAR_LEMON_SQUEEZY_API_KEY=
#HISAR_LEMON_SQUEEZY_STORE_ID=
#HISAR_LEMON_SQUEEZY_WEBHOOK_SECRET=
#HISAR_LEMON_SQUEEZY_MONTHLY_VARIANT_ID=
#HISAR_LEMON_SQUEEZY_YEARLY_VARIANT_ID=
#HISAR_LEMON_SQUEEZY_REDIRECT_URL=https://tryhisar.com/pricing
