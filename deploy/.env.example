# The domain nginx serves Hisar at; clients and invite links use https://<domain>.
HISAR_DOMAIN=hisar.example.com
# The server image the release workflow pushes, without a tag.
HISAR_IMAGE=ghcr.io/tosunlab/hisar-server
# Pin a release (e.g. 0.1.0) so upgrades are deliberate.
HISAR_VERSION=latest
# The localhost port nginx proxies to.
HISAR_PORT=8080

# macOS app updates come from the published desktop releases on GitHub (default tosunlab/hisar, the repository named in core/project; off turns them off).
# While the repository is private, the server needs a fine-grained token with read-only Contents access (see README.md).
#HISAR_DESKTOP_UPDATE_GITHUB_REPOSITORY=tosunlab/hisar
#HISAR_DESKTOP_UPDATE_GITHUB_TOKEN=

# Optional: email for invites and share invitations, usually set in the admin dashboard under Settings → Email, which
# keeps the SMTP password in the database in plain text. Any value here sets all of Email instead (fields left empty
# get their defaults) and locks it in the dashboard; this keeps the password out of the database. Port 465 uses
# implicit TLS; any other port must offer STARTTLS (see README.md).
#HISAR_SMTP_HOST=smtp.example.com
#HISAR_SMTP_PORT=587
#HISAR_SMTP_USERNAME=
#HISAR_SMTP_PASSWORD=
#HISAR_SMTP_FROM=Hisar <noreply@example.com>

# Optional: these override Settings → App versions and Settings → Security → Auth burst in the admin dashboard and lock
# those fields. Older apps get 426 Upgrade Required.
#HISAR_MINIMUM_VERSION_DESKTOP_MACOS=0.1.6
#HISAR_MINIMUM_VERSION_IOS=
#HISAR_MINIMUM_VERSION_CLI=
#HISAR_MINIMUM_VERSION_EXTENSION=
#HISAR_AUTH_BURST=10
