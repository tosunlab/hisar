{
  "name": "hisar-extension",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build": "vite build && vite build --config vite.content.config.ts",
    "package": "node tools/package-extension.mjs",
    "package:store": "node tools/package-store-extension.mjs",
    "test:end-to-end": "npm run build && playwright test extension.spec inline-menu.spec",
    "register-fake-host": "node tools/register-fake-host.mjs",
    "screenshots": "npm run build && playwright test screenshots.spec inline-screenshots.spec"
  },
  "dependencies": {
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.3.0",
    "@types/node": "24.19.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  }
}
