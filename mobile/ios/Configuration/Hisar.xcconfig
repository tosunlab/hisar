#include "Signing.xcconfig"
#include? "Local.xcconfig"

HISAR_APP_BUNDLE_IDENTIFIER = $(HISAR_BUNDLE_IDENTIFIER_PREFIX)
HISAR_AUTOFILL_BUNDLE_IDENTIFIER = $(HISAR_BUNDLE_IDENTIFIER_PREFIX).autofill
HISAR_NOTIFICATION_SERVICE_BUNDLE_IDENTIFIER = $(HISAR_BUNDLE_IDENTIFIER_PREFIX).notification-service
HISAR_APP_GROUP_IDENTIFIER = group.$(HISAR_BUNDLE_IDENTIFIER_PREFIX)
HISAR_KEYCHAIN_ACCESS_GROUP = $(AppIdentifierPrefix)$(HISAR_BUNDLE_IDENTIFIER_PREFIX).shared

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
IPHONEOS_DEPLOYMENT_TARGET = 26.0
// The personal team build signs automatically; Hisar and its extension sign manually (TeamSigning in project.yml).
CODE_SIGN_STYLE = Automatic
