<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Sign-in forms in the test APK's own package, which Hisar's AutoFill service fills in AutofillServiceUITests. -->
        <activity
            android:name="com.tryhisar.hisar.autofill.AutofillTestPageActivity"
            android:exported="true"
            android:label="Test page"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <activity
            android:name="com.tryhisar.hisar.autofill.AutofillTestFormActivity"
            android:exported="true"
            android:label="Test form"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <!-- A native app that asks Credential Manager for passkeys and passwords, in the test APK's package, for PasskeyUITests. -->
        <activity
            android:name="com.tryhisar.hisar.passkey.CredentialCallerActivity"
            android:exported="true"
            android:label="Credential caller"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <activity
            android:name="com.tryhisar.hisar.HandoffReceiverActivity"
            android:exported="true"
            android:label="Handoff receiver"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
        <provider
            android:name="com.tryhisar.hisar.RejectWritesProvider"
            android:authorities="com.tryhisar.hisar.test.rejectwrites"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>

</manifest>
